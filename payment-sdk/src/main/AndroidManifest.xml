<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <!--
            Orientation is intentionally NOT locked. From Android 16 (API 36) the
            platform ignores screenOrientation/resizableActivity restrictions on
            large-screen devices (>= sw600dp). Screens are built to be responsive
            and resizable so they render correctly on foldables and tablets.
        -->
        <activity
            android:name="payment.sdk.android.payments.PaymentsActivity"
            android:exported="false" />
        <activity
            android:name="payment.sdk.android.visaInstalments.VisaInstallmentsActivity"
            android:theme="@style/SdkTheme.ThreeDSecure"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name="payment.sdk.android.cardpayment.CardPaymentActivity"
            android:theme="@style/SdkTheme.Translucent"
            android:windowSoftInputMode="adjustResize|stateUnchanged" />
        <!--
            configChanges: these activities host the 3-D Secure ACS page (incl. the OTP
            challenge) in a WebView whose form state lives only in memory. Without this,
            an orientation/size change recreates the activity, rebuilds the WebView and
            restarts the 3DS flow, so any OTP the user has typed is lost (notably in
            landscape). Handling the config change ourselves keeps the same WebView alive.
            This is NOT screenOrientation, so orientation stays unlocked for foldables/tablets.
        -->
        <activity
            android:name="payment.sdk.android.cardpayment.threedsecure.ThreeDSecureWebViewActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|keyboard"
            android:theme="@style/SdkTheme.ThreeDSecure" />
        <activity
            android:name="payment.sdk.android.cardpayment.threedsecuretwo.webview.ThreeDSecureTwoWebViewActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|keyboard"
            android:theme="@style/SdkTheme.ThreeDSecure" />
        <activity
            android:name="payment.sdk.android.savedCard.SavedCardPaymentActivity"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/SdkTheme.ThreeDSecure" />
        <activity
            android:name="payment.sdk.android.aaniPay.AaniPayActivity"
            android:windowSoftInputMode="adjustResize"
            android:exported="true"
            android:theme="@style/SdkTheme.ThreeDSecure">

            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="niannipay" android:host="open" />
            </intent-filter>
        </activity>
        <activity
            android:name="payment.sdk.android.partialAuth.PartialAuthActivity"
            android:theme="@style/SdkTheme.ThreeDSecure"
            android:windowSoftInputMode="adjustResize" />
    </application>

</manifest>
