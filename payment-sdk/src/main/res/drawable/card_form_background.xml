<?xml version="1.0" encoding="utf-8"?>
<!-- Card preview of the card payment form: left-to-right gradient (one colour by default),
     rounded and outlined like the iOS SDK. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="0"
        android:centerColor="@color/payment_sdk_card_center_color"
        android:endColor="@color/payment_sdk_card_end_color"
        android:startColor="@color/payment_sdk_card_start_color"
        android:type="linear" />
    <stroke android:width="1dp" android:color="#000000" />
    <corners android:radius="16dp" />
</shape>
