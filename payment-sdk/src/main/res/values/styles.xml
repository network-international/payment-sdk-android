<resources>

    <style name="SdkTheme" />

    <style name="SdkTheme.Translucent" parent="Theme.AppCompat.Light.Dialog">
        <item name="windowNoTitle">true</item>
        <item name="android:windowCloseOnTouchOutside">false</item>
        <item name="android:windowBackground">@drawable/bottom_sheet_background</item>
        <item name="android:windowAnimationStyle">@style/Animation.Design.BottomSheetDialog</item>
        <item name="colorAccent">@color/blue</item>
    </style>

    <style name="OpaqueDialogTheme" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="android:windowIsTranslucent">true</item>
    </style>

    <style name="SdkTheme.ThreeDSecure" parent="Theme.AppCompat.Light.NoActionBar" >
        <item name="colorAccent">@color/blue</item>
    </style>

    <style name="SdkTheme.PayButton" parent="Base.Widget.AppCompat.Button.Colored">
        <item name="colorButtonNormal">@color/blue</item>
        <item name="colorControlHighlight">@color/dark_blue</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="SdkTheme.ToolBarTheme" parent="@style/ThemeOverlay.AppCompat.ActionBar">
        <item name="android:background">@color/payment_sdk_toolbar_color</item>
        <item name="colorControlNormal">@color/payment_sdk_toolbar_icon_color</item>
        <item name="android:textColorPrimary">@color/payment_sdk_toolbar_text_color</item>
    </style>

    <!-- Card payment form rows (iOS layout: 60dp rows, label column, borderless fields) -->
    <style name="SdkTheme.CardFormRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">60dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <style name="SdkTheme.CardFormLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minWidth">100dp</item>
        <item name="android:layout_marginEnd">20dp</item>
        <item name="android:textColor">@color/payment_sdk_floating_hint_color</item>
        <item name="android:textSize">17sp</item>
    </style>

    <style name="SdkTheme.CardFormField">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@null</item>
        <item name="android:padding">0dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textColorHint">@color/payment_sdk_text_field_placeholder_color</item>
        <item name="android:textAlignment">viewStart</item>
        <!-- Follow the screen direction so typed digits sit next to the label in Arabic, as on iOS. -->
        <item name="android:textDirection">locale</item>
    </style>

    <style name="SdkTheme.CardFormDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@color/payment_sdk_divider_color</item>
    </style>
</resources>
